  "lyrics": [
    { "id": "v1-1", "section": "verse-1", "from": 0, "to": 8, "text": "Oh, the hills are waking slowly, and the valley hums along," },
    { "id": "v1-2", "section": "verse-1", "from": 9, "to": 16, "text": "every window lit and open to the quiet morning song." },
    { "id": "r1-1", "section": "refrain-1", "from": 17, "to": 22, "text": "Sing aloud, sing aloud," },
    { "id": "r1-2", "section": "refrain-1", "from": 23, "to": 28, "text": "let the morning carry the sound." },
    { "id": "v2-1", "section": "verse-2", "from": 35, "to": 42, "text": "Now the river turns to silver, and the swallows circle high," },
    { "id": "v2-2", "section": "verse-2", "from": 43, "to": 50, "text": "every shadow shorter, lighter, as the noonday hours go by." },
    { "id": "r2-1", "section": "refrain-2", "from": 51, "to": 56, "text": "Sing aloud, sing aloud," },
    { "id": "r2-2", "section": "refrain-2", "from": 57, "to": 62, "text": "let the evening carry the sound." },
    { "id": "co-1", "section": "coda", "from": 63, "to": 68, "text": "Carry the sound away." }
  ],
