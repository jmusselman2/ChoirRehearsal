  "lyrics": [
    { "id": "v1-1", "section": "verse-1", "from": 3, "to": 10, "text": "Lanterns hang along the harbor, bobbing in the evening tide," },
    { "id": "v1-2", "section": "verse-1", "from": 11, "to": 18, "text": "and the boats come home to shelter where the quiet waters hide." },
    { "id": "v2-1", "section": "verse-2", "from": 19, "to": 25, "text": "Someone sings across the water, someone answers from the shore," },
    { "id": "v2-2", "section": "verse-2", "from": 27, "to": 34, "text": "and the tune goes on and on, a little sweeter than before." },
    { "id": "fv-1", "section": "final-verse", "from": 35, "to": 42, "text": "Lanterns hang along the harbor, lighting everyone their way," },
    { "id": "fv-2", "section": "final-verse", "from": 43, "to": 50, "text": "home again, home again, at the closing of the day." }
  ],
